\RequirePackage{graphicx}

% accents (needed for \accentset in \harpvec)
\IfFileExists{accents.sty}{\RequirePackage{accents}}{}

% Gödel/Tarski corners
\IfFileExists{stmaryrd.sty}{\RequirePackage{stmaryrd}}{}

% ---------- Mild bussproofs spacing tweaks ----------
\ifandyspackage@prooftrees
  \def\defaultHypSeparation{\hskip .8em}
  \def\defaultTopSkip{.5em}
  \def\defaultBottomSkip{.5em}
\fi

% ---------- Mathtools paired delimiters ----------
\DeclarePairedDelimiter\parens{(}{)}
\DeclarePairedDelimiter\bracks{[}{]}
\DeclarePairedDelimiter\braces{\{}\}
\DeclarePairedDelimiter\angles{\langle}{\rangle}
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\DeclarePairedDelimiter\ceil{\lceil}{\rceil}
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor}

% Set-builder: \set{a,b} or \set[x\in X]{x : \varphi(x)}
\NewDocumentCommand{\set}{ O{} m }{%
  \if\relax\detokenize{#1}\relax
    \braces*{#2}%
  \else
    \braces*{\,#2 \;\middle|\; #1\,}%
  \fi
}

% ---------- Logic relations ----------
\NewDocumentCommand{\proves}{ }{\mathrel{\vdash}}
\NewDocumentCommand{\notproves}{ }{\mathrel{\nvdash}}
\NewDocumentCommand{\entails}{ }{\mathrel{\vDash}}
\NewDocumentCommand{\notentails}{ }{\mathrel{\nvDash}}
\NewDocumentCommand{\satisfies}{ }{\mathrel{\models}}
\NewDocumentCommand{\notsatisfies}{ }{\mathrel{\not\models}}
\NewDocumentCommand{\forces}{ }{\mathrel{\Vdash}}
\NewDocumentCommand{\notforces}{ }{\mathrel{\nVdash}}
\newcommand{\contradiction}{\bot}
\newcommand{\impliesbottom}{\Longrightarrow\bot}
\newcommand{\impliesbot}{\Longrightarrow\bot}
\newcommand{\bottom}{\bot}
\newcommand{\yippee}{\top}

% Forcing with a poset subscript: \forcesP{P}{p}{\varphi} -> p \Vdash_P \varphi
\NewDocumentCommand{\forcesP}{m m m}{#2 \Vdash_{#1} #3}

% Labeled turnstile: \turnstile[\mathsf{S}]{\Gamma}{\Delta}
\NewDocumentCommand{\turnstile}{ O{} m m }{#2 \mathrel{\vdash_{#1}} #3}
% Sequent turnstile (used in bussproofs examples)
\providecommand{\fCenter}{\mathrel{\vdash}}

% ---------- Common metavariables ----------
\NewDocumentCommand{\Var}{ }{\mathcal{V}}
\NewDocumentCommand{\Frm}{ }{\mathcal{F}}
\NewDocumentCommand{\Str}{ }{\mathcal{M}}
\NewDocumentCommand{\Lang}{ }{\mathcal{L}}
\NewDocumentCommand{\Th}{ }{\mathrm{Th}}

% ---------- Arrows / maps ----------
\newcommand{\inj}{\rightarrowtail}
\newcommand{\surj}{\twoheadrightarrow}
\newcommand{\incl}{\hookrightarrow}
\newcommand{\notincl}{\mathrel{\not\!\incl}}

% isomorphism arrow
\newcommand{\isoarrow}{\xrightarrow{\sim}}

% Garden variety “bijection exists” arrow (your convention)
\newcommand{\bij}{\leftrightarrow}

%Consistent Bijection, as defined as injection + Surjection: 
% Consistent bijection arrow: surjection + injection (tail + two heads)
% (TeXLive/Overleaf do not define \twoheadrightarrowtail by default.)
\newcommand{\isbij}{\mathrel{\rightarrowtail\mkern-14.75mu\twoheadrightarrow}}

% Logical iff arrow (avoid \iff which is already defined by TeX)
\newcommand{\iffarrow}{\Longleftrightarrow}

% Barbed bijection to show inclusion (stacked hook + twohead arrow)
\newcommand{\barbbij}{%
  \mathrel{\mathrlap{\hookrightarrow}}\mathrel{\mkern4.5mu\twoheadrightarrow}%
}
\newcommand{\notbarbbij}{\mathrel{\not\!\barbbij}}

% Hooked left-right arrows public name: \hbij
\newcommand{\hbij}{%
  \mathrel{\mathpalette\hookleftrightarrows@{2}}%
}
\newcommand{\hookleftrightarrows@}[2]{%
  \vcenter{%
    \offinterlineskip\m@th
    \sbox\z@{$#1\mkern#2mu$}%
    \ialign{##\cr
      $#1\mkern1mu\hookrightarrow$\cr
      \noalign{\kern-\wd\z@}%
      \rotatebox[origin=C]{180}{$#1\mkern1mu\hookrightarrow$}\cr
    }%
  }%
}

% ---------- Gödel/Tarski coding corners ----------
\NewDocumentCommand{\gcode}{m}{\ulcorner #1\urcorner}
\NewDocumentCommand{\gcodel}{ }{\ulcorner}
\NewDocumentCommand{\gcoder}{ }{\urcorner}
\NewDocumentCommand{\gfloor}{m}{\llcorner #1\lrcorner}
\NewDocumentCommand{\tarski}{m}{\gcode{#1}}

% ---------- Vectors ----------
\@ifpackageloaded{accents}
  {\newcommand{\harpvec}[1]{\accentset{\rightharpoonup}{#1}}}
  {\newcommand{\harpvec}[1]{\overset{\rightharpoonup}{#1}}}
\newcommand{\zerovec}{\harpvec{\mathbf{0}}}

% ---------- Kripke helpers (enabled by [kripke] or [ij]) ----------
\newif\ifandyspackage@enablekripke
\ifandyspackage@kripke\andyspackage@enablekripketrue\fi
\ifandyspackage@ij\andyspackage@enablekripketrue\fi
\ifandyspackage@ii\andyspackage@enablekripketrue\fi

% Chevrons for tuples/structures (always available)
\NewDocumentCommand{\tuple}{m}{\angles*{#1}}
\NewDocumentCommand{\struc}{m}{\angles*{#1}}

% Explicit names avoid confusing accessibility with Peano successor S.
\newcommand{\kripkesucceq}{\succeq}
\newcommand{\kripkesucc}{\succ}
\newcommand{\kripkepreceq}{\preceq}
\newcommand{\kripkeprec}{\prec}

\ifandyspackage@enablekripke
  \NewDocumentCommand{\Worlds}{ }{\mathcal{W}}
  \NewDocumentCommand{\Acc}{ }{\kripkesucceq}
  \NewDocumentCommand{\Frame}{ }{\mathcal{F}}
  \NewDocumentCommand{\Model}{ }{\mathcal{M}}
  \NewDocumentCommand{\kripkeframe}{m m}{\angles*{#1,#2}}
  \NewDocumentCommand{\kripkemodel}{m m m}{\angles*{#1,#2,#3}}
  \NewDocumentCommand{\KripkeLegend}{ }{%
    \par\noindent\footnotesize
    \textbf{Kripke:} frame $\kripkeframe{\Worlds}{\Acc}$, model $\kripkemodel{\Worlds}{\Acc}{V}$, and $w\forces\varphi$ monotone wrt.\ $\Acc$.\par
  }
\else
  \NewDocumentCommand{\KripkeLegend}{ }{}
\fi


% ---------- Kripke / preorder relation glyphs ----------

% strict part
\newcommand{\AccS}{\kripkesucc}

% converse (sometimes handy)
\newcommand{\AccInv}{\kripkepreceq}
\newcommand{\AccInvS}{\kripkeprec}

% Optional: a "slanted ≥" if you literally want ≥ but prettier
\newcommand{\gecurly}{\geqslant}


% ---------- LJ (Gentzen) rule shorthands ----------
% Available with \usepackage[prooftrees]{andyspackage}.
\ifandyspackage@prooftrees
\newcommand{\rlabel}[1]{\RightLabel{\scriptsize #1}}

\newcommand{\WeakL}{\rlabel{(Weak L)}\UnaryInfC}
\newcommand{\WeakR}{\rlabel{(Weak R)}\UnaryInfC}
\newcommand{\ContrL}{\rlabel{(Contr L)}\UnaryInfC}
\newcommand{\ContrR}{\rlabel{(Contr R)}\UnaryInfC}
\newcommand{\ExchL}{\rlabel{(Exch L)}\UnaryInfC}
\newcommand{\ExchR}{\rlabel{(Exch R)}\UnaryInfC}
\newcommand{\Cut}{\rlabel{(Cut)}\BinaryInfC}

\newcommand{\ImpR}{\rlabel{$(\to\mathrm{R})$}\UnaryInfC}
\newcommand{\ImpL}{\rlabel{$(\to\mathrm{L})$}\BinaryInfC}
\newcommand{\AndR}{\rlabel{$(\wedge\mathrm{R})$}\BinaryInfC}
\newcommand{\AndL}{\rlabel{$(\wedge\mathrm{L})$}\UnaryInfC}
\newcommand{\OrRone}{\rlabel{$(\vee\mathrm{R}\!1)$}\UnaryInfC}
\newcommand{\OrRtwo}{\rlabel{$(\vee\mathrm{R}\!2)$}\UnaryInfC}
\newcommand{\OrL}{\rlabel{$(\vee\mathrm{L})$}\BinaryInfC}
\newcommand{\NegR}{\rlabel{$(\neg\mathrm{R})$}\UnaryInfC}
\newcommand{\NegL}{\rlabel{$(\neg\mathrm{L})$}\UnaryInfC}
\newcommand{\TopR}{\rlabel{$(\top\mathrm{R})$}\UnaryInfC}
\newcommand{\BotL}{\rlabel{$(\bot\mathrm{L})$}\UnaryInfC}

\newcommand{\AllR}{\rlabel{$(\forall\mathrm{R})$}\UnaryInfC}
\newcommand{\AllL}{\rlabel{$(\forall\mathrm{L})$}\UnaryInfC}
\newcommand{\ExR}{\rlabel{$(\exists\mathrm{R})$}\UnaryInfC}
\newcommand{\ExL}{\rlabel{$(\exists\mathrm{L})$}\UnaryInfC}
\fi

% ---------- Section helper ----------
\newcommand{\LogicLegend}{%
  \par\noindent\footnotesize
  $\Gamma \proves \varphi$ (syntactic),\ 
  $\Gamma \entails \varphi$ (semantic),\ 
  $\Str \satisfies \varphi$ (single model),\ 
  $w \forces \varphi$ (Kripke forcing).\par
}
\ifandyspackage@ij
  \newcommand{\IJSection}[1]{\section{#1}\KripkeLegend\LogicLegend}
\else
  \newcommand{\IJSection}[1]{\section{#1}}
\fi

