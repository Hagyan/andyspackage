% Compatibility with the original six-argument title call.
\NewDocumentCommand{\AndyTitle}{O{} m m m m m}{%
  \ifstrempty{#4}{\title{#2}\AndyCourse{}}{%
    \title{#4}\AndyCourse{#2\ifstrempty{#3}{}{~#3}}}%
  \author{#6}\date{}\AndyDue{#5}\AndyAffiliation{#1}\AndyMakeTitle
}
