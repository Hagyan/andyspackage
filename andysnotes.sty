% Tombstone fill describes source/originality; the label records provenance.
\newcommand{\andy@tombstone}[2]{%
  \begin{tikzpicture}[baseline=-.32ex,x=1em,y=1em]
    \path[fill=white] (0,0)--(0,.72) arc[start angle=180,end angle=0,radius=.35em]--(.7,0)--cycle;
    \begin{scope}
      \clip (0,0)--(0,.72) arc[start angle=180,end angle=0,radius=.35em]--(.7,0)--cycle;
      \ifdefstring{#1}{solid}{\fill[andyaccent!65](0,0) rectangle (.7,1.1);}{%
        \ifdefstring{#1}{hollow}{}{%
          \pgfmathsetmacro{\andy@fraction}{#2}
          \ifdefstring{#1}{right}{%
            \fill[andyaccent!12] ({.7*(1-\andy@fraction)},0) rectangle (.7,1.1);
            \fill[pattern=north east lines,pattern color=andyaccent]
              ({.7*(1-\andy@fraction)},0) rectangle (.7,1.1);
          }{%
            \fill[andyaccent!12] (0,0) rectangle ({.7*\andy@fraction},1.1);
            \fill[pattern=north east lines,pattern color=andyaccent]
              (0,0) rectangle ({.7*\andy@fraction},1.1);
          }%
        }%
      }%
    \end{scope}
    \draw[andyaccent,line width=.55pt](0,0)--(0,.72)
      arc[start angle=180,end angle=0,radius=.35em]--(.7,0)--cycle;
  \end{tikzpicture}%
}
\newcommand{\AndyProofMark}[2][QED]{%
  \ensuremath{\vcenter{\hbox{\microtypesetup{expansion=false}\begin{tabular}{c}
    \andy@tombstone{#2}{1}\\[-.45em]{\scriptsize\texttt{#1}}
  \end{tabular}}}}%
}
\newcommand{\AndyBookMark}[1][QED]{\AndyProofMark[#1]{hollow}}
\newcommand{\AndyGeneralMark}[1][QED]{\AndyProofMark[#1]{general}}
\newcommand{\AndyOriginalMark}[1][QED]{\AndyProofMark[#1]{solid}}
\renewcommand{\qedsymbol}{\AndyGeneralMark[QED]}
\newcommand{\andy@directionmark}[3]{%
  \ensuremath{\vcenter{\hbox{\microtypesetup{expansion=false}\begin{tabular}{c}
    \andy@tombstone{#1}{.5}\\[-.45em]{\scriptsize $#2$}\\[-.55em]{\scriptsize\texttt{#3}}
  \end{tabular}}}}%
}
\NewDocumentEnvironment{IffForwardProof}{O{QED}}
  {\begingroup\renewcommand{\qedsymbol}{\andy@directionmark{general}{\rightarrow}{#1}}\begin{proof}[Forward direction]}
  {\end{proof}\endgroup}
\NewDocumentEnvironment{IffBackwardProof}{O{QED}}
  {\begingroup\renewcommand{\qedsymbol}{\andy@directionmark{right}{\leftarrow}{#1}}\begin{proof}[Backward direction]}
  {\end{proof}\endgroup}

\newcounter{andycase}
\newcounter{andycasetotal}
\NewDocumentEnvironment{CaseProof}{m}
  {\begingroup\setcounter{andycase}{0}\setcounter{andycasetotal}{#1}%
   \par\medskip\noindent\textbf{Proceed by cases.}\par\smallskip}
  {\endgroup}
\NewDocumentEnvironment{AndyCase}{o}
  {\par\medskip\stepcounter{andycase}\noindent
   \textit{\roman{andycase})}\IfValueT{#1}{\ \textbf{(#1)}}\quad}
  {\hfill\AndyCaseProgressMark{\value{andycase}}{\value{andycasetotal}}\par}
\newcommand{\AndyCaseProgressMark}[2]{%
  \parbox{2.3em}{\centering
    \andy@tombstone{general}{\the\numexpr#1\relax/\the\numexpr#2\relax}\\[-.45em]
    {\tiny\texttt{\number#1/\number#2}}}}
\newcommand{\AndyTombstoneFootnote}{\footnote{Hollow marks a proof by the book; striped marks a general proof; solid purple marks a highly original contribution. QED denotes human proof, XM (Ex machina) largely unedited machine output, and AXM (Auxilium ex machina) machine assistance shaped by a human.}}
\newcommand{\AndyProofNotationAppendix}{%
  \section*{Proof marks and machine assistance}
  A hollow tombstone marks a proof quoted from or closely following a source.
  A striped tombstone marks a general proof. A fully shaded tombstone marks a
  highly original contribution. In case analysis, the striped fill advances
  horizontally after each case; the fraction reports completed cases.
  A biconditional may be proved in separate forward and backward directions,
  each ending with a half-striped directional tombstone.
  \textsf{QED} denotes a human proof. \textsf{XM} (Ex machina) denotes a proof
  generated by a machine with little or no human alteration. \textsf{AXM}
  (Auxilium ex machina) denotes a proof developed with machine assistance and
  meaningful human direction, revision, or verification.
}
