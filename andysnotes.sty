\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{andysnotes}[2026/09/29 v2.0 Andrew Hagy document style]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=andysnotes,prefix=andysnotes@}
\DeclareStringOption[book]{header}   % book, plain, none
\DeclareStringOption[times]{font}    % times, latinmodern
\DeclareStringOption[purple]{accent} % purple, black
\DeclareStringOption[manual]{bibliography} % manual, angus
\DeclareBoolOption[true]{sectionrules}
\DeclareBoolOption[false]{showsectionnumbers}
\ProcessKeyvalOptions*

\RequirePackage{amsthm}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{fancyvrb}
\RequirePackage{calligra}
\RequirePackage{lettrine}
\RequirePackage[most]{tcolorbox}
\IfFileExists{siunitx.sty}{\RequirePackage{siunitx}}{}

% Portable Times-family face; exact Times New Roman can be selected in a
% project that supplies the font files.
\ifdefstring{\andysnotes@font}{times}{%
  \RequirePackage[T1]{fontenc}\RequirePackage{mathptmx}%
}{%
  \RequirePackage[T1]{fontenc}\RequirePackage{lmodern}%
}
\definecolor{AndyPurple}{RGB}{86,10,75}
\colorlet{andyaccent}{AndyPurple}
\ifdefstring{\andysnotes@accent}{black}{\colorlet{andyaccent}{black}}{}
\ifdefstring{\andysnotes@bibliography}{angus}{%
  \RequirePackage[backend=biber,bibstyle=alphabetic,citestyle=alphabetic,
    uniquename=init,giveninits=true,dateabbrev=false,
    maxbibnames=9999,url=true]{biblatex}%
  \DeclareNameAlias{sortname}{given-family}%
  \AtBeginBibliography{\renewcommand*{\finalnamedelim}{\addcomma\ and }}%
}{}
\PassOptionsToPackage{pdfpagelabels}{hyperref}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=andyaccent,citecolor=andyaccent,
  urlcolor=andyaccent}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt minus 1pt}
\setlength{\headheight}{40pt}

% The section counter runs normally, although its number is invisible.
\ifandysnotes@showsectionnumbers
  \titleformat{\section}{\Large\bfseries\color{andyaccent}}{\thesection}{.7em}{}
  \titlecontents{section}[0em]{\addvspace{.7em}\bfseries}
    {\contentslabel{1.8em}}{}{\titlerule*[.5pc]{.}\contentspage}
\else
  \titleformat{\section}{\Large\bfseries\color{andyaccent}}{}{0pt}{}
  \titlecontents{section}[0em]{\addvspace{.7em}\bfseries}
    {}{}{\titlerule*[.5pc]{.}\contentspage}
\fi
\ifandysnotes@sectionrules
  \ifandysnotes@showsectionnumbers
    \titleformat{\section}{\Large\bfseries\color{andyaccent}}{\thesection}{.7em}{}
      [\vspace{.12em}{\color{andyaccent}\titlerule[.55pt]}]
  \else
    \titleformat{\section}{\Large\bfseries\color{andyaccent}}{}{0pt}{}
      [\vspace{.12em}{\color{andyaccent}\titlerule[.55pt]}]
  \fi
\fi
\titleformat{\subsection}{\large\bfseries\color{andyaccent}}
  {\thesubsection}{.65em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{andyaccent}}
  {\thesubsubsection}{.65em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .6ex}{1.2ex}
\titlespacing*{\subsection}{0pt}{1.7ex plus .4ex}{.7ex}

\renewcommand{\sectionmark}[1]{\markboth{#1}{}}
\renewcommand{\subsectionmark}[1]{\markright{\thesubsection\quad #1}}
\newcommand{\andy@runningtitle}{\@title}
\newcommand{\AndyRunningTitle}[1]{\gdef\andy@runningtitle{#1}}
\fancypagestyle{andybook}{%
  \fancyhf{}
  \if@twoside
    \fancyhead[LE,RO]{\color{andyaccent}\thepage}
    \fancyhead[LO]{\color{andyaccent}\nouppercase{\leftmark}}
    \fancyhead[RE]{\color{andyaccent}\nouppercase{\andy@runningtitle}}
  \else
    \fancyhead[L]{\color{andyaccent}\nouppercase{\leftmark}}
    \fancyhead[R]{\color{andyaccent}\thepage}
  \fi
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\headrule}{%
    \hbox to\headwidth{\color{andyaccent}\leaders\hrule height .8pt\hfill}%
    \vskip 1.5pt
    \hbox to\headwidth{\color{andyaccent}\leaders\hrule height .35pt\hfill}%
  }
}
\fancypagestyle{andyplain}{%
  \fancyhf{}
  \fancyhead[L]{\nouppercase{\leftmark}}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{.4pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{andyaccent}\leaders\hrule height .4pt\hfill}}
}
\fancypagestyle{andynone}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}
}
\ifdefstring{\andysnotes@header}{book}{\pagestyle{andybook}}{%
  \ifdefstring{\andysnotes@header}{none}{\pagestyle{andynone}}{\pagestyle{andyplain}}%
}
\newcommand{\AndyStartBodyPages}{\clearpage\pagenumbering{arabic}\setcounter{page}{0}}

\makeatletter
\newcommand{\andy@subtitle}{}
\newcommand{\andy@course}{}
\newcommand{\andy@assignment}{}
\newcommand{\andy@due}{}
\newcommand{\andy@affiliation}{}
\newcommand{\AndySubtitle}[1]{\gdef\andy@subtitle{#1}}
\newcommand{\AndyCourse}[1]{\gdef\andy@course{#1}}
\newcommand{\AndyAssignment}[1]{\gdef\andy@assignment{#1}}
\newcommand{\AndyDue}[1]{\gdef\andy@due{#1}}
\newcommand{\AndyAffiliation}[1]{\gdef\andy@affiliation{#1}}
\newcommand{\AndyMakeTitle}{%
  \begin{center}
    \ifdefempty{\andy@course}{}{{\small\scshape \andy@course\par}\vspace{.3em}}%
    {\LARGE\bfseries\color{andyaccent}\@title\par}
    \ifdefempty{\andy@subtitle}{}{\vspace{.25em}{\large\andy@subtitle\par}}%
    \ifdefempty{\andy@assignment}{}{\vspace{.3em}{\large\andy@assignment\par}}%
    \vspace{.8em}
    {\large\@author\par}
    \ifdefempty{\andy@affiliation}{}{{\small\andy@affiliation\par}}%
    \ifdefempty{\andy@due}{}{\vspace{.3em}{\small Due: \andy@due\par}}%
    \ifdefempty{\@date}{}{\vspace{.3em}{\small\@date\par}}%
    \vspace{.55em}
    {\color{andyaccent}\rule{4.8cm}{.75pt}\par\vspace{2pt}\rule{4.8cm}{.3pt}\par}
  \end{center}
  \vspace{.6em}
}
\newcommand{\AndyMakeTitlePage}{%
  \begin{titlepage}\vspace*{.13\textheight}\AndyMakeTitle\end{titlepage}%
}
% Compatibility with the original six-argument title call.
\NewDocumentCommand{\AndyTitle}{O{} m m m m m}{%
  \ifstrempty{#4}{\title{#2}\AndyCourse{}}{%
    \title{#4}\AndyCourse{#2\ifstrempty{#3}{}{~#3}}}%
  \author{#6}\date{}\AndyDue{#5}\AndyAffiliation{#1}\AndyMakeTitle
}
\makeatother

% One subsection-local counter for definitions, lemmas, asides, and peers.
\newtheoremstyle{andystatement}{.8\baselineskip}{.8\baselineskip}
  {\normalfont}{}{\color{andyaccent}\bfseries}{.}{.5em}{}
\newtheoremstyle{andytheorem}{.8\baselineskip}{.8\baselineskip}
  {\itshape}{}{\color{andyaccent}\bfseries}{.}{.5em}{}
\theoremstyle{andystatement}
\newtheorem{definition}{Definition}[subsection]
\renewcommand{\thedefinition}{%
  \thesection\ifnum\value{subsection}>0 .\arabic{subsection}\fi.\arabic{definition}}
\newtheorem{lemma}[definition]{Lemma}
\newtheorem{proposition}[definition]{Proposition}
\newtheorem{claim}[definition]{Claim}
\newtheorem{example}[definition]{Example}
\newtheorem{remark}[definition]{Remark}
\newtheorem{note}[definition]{Note}
\newtheorem{exercise}[definition]{Exercise}
\newtheorem{chaff}[definition]{Chaff}
\newtheorem{aside}[definition]{Aside}
\theoremstyle{andytheorem}
\newtheorem{theorem}{Theorem}
\newtheorem{conjecture}{Conjecture}
\newtheorem{corollary}{Corollary}[theorem]
\renewcommand{\thecorollary}{\thetheorem.\roman{corollary}}
\renewcommand{\qedsymbol}{\ensuremath{\blacksquare}}

\tcbset{andy statement/.style={
  enhanced jigsaw,breakable,
  colback=black!1.5,colframe=andyaccent!42,
  boxrule=.45pt,arc=2pt,
  left=9pt,right=9pt,top=5pt,bottom=5pt,
  before skip=9pt,after skip=9pt,
  pad at break*=2mm
}}
\newtcolorbox{andybox}{andy statement}

% Boxed and unboxed forms use the same statement counter.
\NewDocumentEnvironment{DefinitionBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{definition}}{\begin{definition}[#1]}}
  {\end{definition}\end{andybox}}
\NewDocumentEnvironment{LemmaBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{lemma}}{\begin{lemma}[#1]}}
  {\end{lemma}\end{andybox}}
\NewDocumentEnvironment{PropositionBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{proposition}}{\begin{proposition}[#1]}}
  {\end{proposition}\end{andybox}}
\NewDocumentEnvironment{ClaimBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{claim}}{\begin{claim}[#1]}}
  {\end{claim}\end{andybox}}
\NewDocumentEnvironment{ExampleBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{example}}{\begin{example}[#1]}}
  {\end{example}\end{andybox}}
\NewDocumentEnvironment{RemarkBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{remark}}{\begin{remark}[#1]}}
  {\end{remark}\end{andybox}}
\NewDocumentEnvironment{NoteBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{note}}{\begin{note}[#1]}}
  {\end{note}\end{andybox}}
\NewDocumentEnvironment{ExerciseBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{exercise}}{\begin{exercise}[#1]}}
  {\end{exercise}\end{andybox}}
\NewDocumentEnvironment{ChaffBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{chaff}}{\begin{chaff}[#1]}}
  {\end{chaff}\end{andybox}}
\NewDocumentEnvironment{AsideBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{aside}}{\begin{aside}[#1]}}
  {\end{aside}\end{andybox}}
\NewDocumentEnvironment{TheoremBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{theorem}}{\begin{theorem}[#1]}\normalfont}
  {\end{theorem}\end{andybox}}
\NewDocumentEnvironment{ConjectureBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{conjecture}}{\begin{conjecture}[#1]}\normalfont}
  {\end{conjecture}\end{andybox}}
\NewDocumentEnvironment{CorollaryBlock}{o}
  {\begin{andybox}\IfNoValueTF{#1}{\begin{corollary}}{\begin{corollary}[#1]}\normalfont}
  {\end{corollary}\end{andybox}}
\NewDocumentEnvironment{ProofBlock}{o}
  {\par\smallskip{\color{andyaccent}\hrule height .35pt}\smallskip
   \IfNoValueTF{#1}{\begin{proof}}{\begin{proof}[#1]}}
  {\end{proof}\smallskip{\color{andyaccent}\hrule height .35pt}\par\smallskip}

% Original numbered aliases remain accepted in older projects.
\NewDocumentEnvironment{ntheorem}{o}
  {\IfNoValueTF{#1}{\begin{theorem}}{\begin{theorem}[#1]}}{\end{theorem}}
\NewDocumentEnvironment{nlemma}{o}
  {\IfNoValueTF{#1}{\begin{lemma}}{\begin{lemma}[#1]}}{\end{lemma}}
\NewDocumentEnvironment{ndefinition}{o}
  {\IfNoValueTF{#1}{\begin{definition}}{\begin{definition}[#1]}}{\end{definition}}
\NewDocumentEnvironment{nproposition}{o}
  {\IfNoValueTF{#1}{\begin{proposition}}{\begin{proposition}[#1]}}{\end{proposition}}
\NewDocumentEnvironment{ncorollary}{o}
  {\IfNoValueTF{#1}{\begin{corollary}}{\begin{corollary}[#1]}}{\end{corollary}}
\NewDocumentEnvironment{nremark}{o}
  {\IfNoValueTF{#1}{\begin{remark}}{\begin{remark}[#1]}}{\end{remark}}
\NewDocumentEnvironment{nchaff}{o}
  {\IfNoValueTF{#1}{\begin{chaff}}{\begin{chaff}[#1]}}{\end{chaff}}
\NewDocumentEnvironment{naside}{o}
  {\IfNoValueTF{#1}{\begin{aside}}{\begin{aside}[#1]}}{\end{aside}}
\NewDocumentEnvironment{nclaim}{o}
  {\IfNoValueTF{#1}{\begin{claim}}{\begin{claim}[#1]}}{\end{claim}}

