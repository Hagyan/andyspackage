\newcommand{\SFSoC}{\textsc{sfsoc}}
\newcommand{\DearFriends}[2]{%
  \lettrine[lines=2,lraise=.35,findent=1em,nindent=0pt]{\calligra Dear} #1,\\
  #2\par\medskip
}
