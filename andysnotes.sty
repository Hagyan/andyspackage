\newcommand{\AndyMakeTitle}{%
  \begin{center}
    \ifdefempty{\andy@course}{}{{\small\scshape \andy@course\par}\vspace{.3em}}%
    {\LARGE\bfseries\color{andyaccent}\@title\par}
    \ifdefempty{\andy@subtitle}{}{\vspace{.25em}{\large\andy@subtitle\par}}%
    \ifdefempty{\andy@assignment}{}{\vspace{.3em}{\large\andy@assignment\par}}%
    \vspace{.8em}
    {\large\@author\par}
    \ifdefempty{\andy@affiliation}{}{{\small\andy@affiliation\par}}%
    \ifdefempty{\andy@due}{}{\vspace{.3em}{\small Due: \andy@due\par}}%
    \ifdefempty{\@date}{}{\vspace{.3em}{\small\@date\par}}%
    \vspace{.55em}
    {\color{andyaccent}\rule{4.8cm}{.75pt}\par\vspace{2pt}\rule{4.8cm}{.3pt}\par}
  \end{center}
  \vspace{.6em}
}
